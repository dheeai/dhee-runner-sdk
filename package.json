{
  "name": "@dheeai/runner-sdk",
  "version": "0.4.0",
  "description": "Authoring SDK for Dhee runners & bundles — the firewall a runner depends on.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/dheeai/dhee-runner-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dheeai/dhee-runner-sdk.git"
  },
  "keywords": [
    "dhee",
    "dhee-runner",
    "sdk",
    "runner",
    "bundle"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "peerDependenciesMeta": {
    "@ffmpeg-installer/ffmpeg": {
      "optional": true
    },
    "@ffprobe-installer/ffprobe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
